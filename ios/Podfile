# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase Apple SDK 13 (RNFirebase v27) is resolved through SPM and requires
# dynamic framework linkage.
use_frameworks! :linkage => :dynamic

use_modular_headers! 

target 'DoitpayMobileApp' do
  pod 'react-native-config', :path => '../node_modules/react-native-config'

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix for "Could not build module" errors
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['SWIFT_VERSION'] = '5.0'

        # react-native-image-picker uses UTType APIs from these frameworks,
        # but its podspec does not link them.
        if target.name == 'react-native-image-picker'
          flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          flags = [flags] unless flags.is_a?(Array)
          ['MobileCoreServices', 'UniformTypeIdentifiers'].each do |framework|
            flags += ['-framework', framework] unless flags.include?(framework)
          end
          config.build_settings['OTHER_LDFLAGS'] = flags
        end
      end
    end

    # FirebaseMessaging references GULAppDelegateSwizzler. RNFBMessaging 27.1.1
    # does not declare that transitive GoogleUtilities product directly, so
    # Xcode can omit it when linking RNFBMessaging under SPM.
    messaging_target = installer.pods_project.targets.find { |target| target.name == 'RNFBMessaging' }
    google_utilities_package = installer.pods_project.root_object.package_references.find do |package|
      package.respond_to?(:repositoryURL) && package.repositoryURL.include?('google/GoogleUtilities')
    end

    if messaging_target && google_utilities_package &&
       messaging_target.package_product_dependencies.none? { |dependency| dependency.product_name == 'GULAppDelegateSwizzler' }
      product = installer.pods_project.new(Xcodeproj::Project::Object::XCSwiftPackageProductDependency)
      product.package = google_utilities_package
      product.product_name = 'GULAppDelegateSwizzler'
      messaging_target.package_product_dependencies << product

      build_file = installer.pods_project.new(Xcodeproj::Project::Object::PBXBuildFile)
      build_file.product_ref = product
      messaging_target.frameworks_build_phase.files << build_file
    end
  end
end
